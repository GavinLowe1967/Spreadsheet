/* Program for processing admissions shortlisting.  This expects to find
 * columns with certain headers in row #0. */

#include "haskell.dir"
#include "spreadsheet.dir"

/** The column with `title` in row #0. */
def columnFor(title: String): Column = {
  def search(c: Column): Column = { 
    assert(c <= #Z); if(Cell(c,#0): String == title) c else search(c+1)
  }
  search(#A)
}
/** The value in the cell with column-title `title`, row `row`. */
// def cellFor[A <: CellType](title: String, r: Row): A = 
//   Cell(columnFor(title), r): A

/* Weights for various factors. */
val Pre16Weight = 0.8; val Post16Weight = 0.8
val IMDWeight = 0.6; val AcornWeight = 0.6; val FSMWeight = 0.8
val TestWeight = 6.0; val ContextWeight = 1.0; 
val bGCSEWeight = 0.10; val cGCSEWeight = 1.5

/* The columns for input data. */
val pre16C = columnFor("Pre-16"); val post16C = columnFor("Post-16")
val IMDC = columnFor("IMD"); val acornC = columnFor("Acorn")
val fsmC = columnFor("FSM"); val extraCC = columnFor("Extra contextual")
val psC = columnFor("PS"); val refC = columnFor("Reference")
val bgcseC = columnFor("bGCSE"); val cgcseC = columnFor("cGCSE")
val aLevelAStarC = columnFor("A level A*s"); 
val aLevelAC = columnFor("A level As")
val testC = columnFor("Test")

/* The columns for output. */
val contextC = columnFor("Total contextual") 
val schoolResC = columnFor("School results")
val totalC = columnFor("Total")

/** The entry in cell (c,r), interpreted as a Float. */
def cellToFloat(c: Column, r: Row): Float = Cell(c,r) match{
  case n: Int => toFloat n; case x: Float => x; case Empty => 0.0
}

/* Helper functions.  Each of these returns a float, where a higher value is
 * advantageous to the candidate, but where scaling is still required.  Empty
 * cells are treated appropriately. */
/** Test score for the candidate in row `r`. */
def test(r: Row): Float = Cell(testC, r)
/* Pre-16 and post-16 school scores, normalised to range 0 (good school) to 4
  * (bad school). */
def pre16(r: Row): Float =   
  Cell(pre16C,r) match{ case n: Int => 5.0-toFloat n; case Empty => 0.0 }
def post16(r: Row): Float = 
  Cell(post16C,r) match{ case n: Int => 5.0-toFloat n; case Empty => 0.0 }
/** Normalised Polar, in range [0..5).  High raw score = good area. */
def imd(r: Row): Float = Cell(IMDC,r) match{
  case n: Int => { assert(0 < n && n <= 5); 5.0-toFloat n}; case Empty => 0.0 
}
/** Normalised Acorn, in range [0..5).  High raw score = bad area. */
def acorn(r: Row): Float = Cell(acornC,r) match{ 
  case n: Int => { assert(0 < n && n <= 6); toFloat n-1.0 }; case Empty => 0.0
}
/** Normalised Free school meals, in range [0..5). */
def fsm(r: Row): Float = Cell(fsmC,r) match{ 
  case n: Int => { assert(0 < n && n <= 5); 5.0-toFloat n }; case Empty => 0.0 
}
/** Extra contextual information. */
def extraC(r: Row): Float = Cell(extraCC,r) match{ 
  case n: Int => { assert(0 <= n); toFloat n }; case Empty => 0.0 
}
/** Personal statement. */
def ps(r: Row): Float = cellToFloat(psC,r)
/** Reference. */
def ref(r: Row): Float = cellToFloat(refC,r) 
/* School results. */
def bgcse(r: Row) = 
  Cell(bgcseC,r) match{ case x: Float => x-70.0; case Empty => 0.0 }
def cgcse(r: Row) = 
  Cell(cgcseC,r) match{ case x: Float => x+1.0; case Empty => 0.0 }
def aLevel(r: Row) =
  min (cellToFloat(aLevelAStarC,r)*4.0+cellToFloat(aLevelAC,r)*2.0) 14.0

val endRow = firstEmptyInColumn(#A) // Column after last candidate.

for(r <- #1 until endRow){  // Calculate values for candidate in row r. 
  val contextual =
    pre16(r)*Pre16Weight + post16(r)*Post16Weight + 
    imd(r)*IMDWeight + acorn(r)*AcornWeight + fsm(r)*FSMWeight + extraC(r)
  val schoolResults = bgcse(r)*bGCSEWeight + cgcse(r)*cGCSEWeight + aLevel(r)
  Cell(contextC,r) = contextual
  Cell(schoolResC,r) = schoolResults
  Cell(totalC,r) = 
    test(r)*TestWeight + contextual*ContextWeight + schoolResults +
    ps(r) + ref(r)
}
