// ===== Utilities that are specifically oriented towards a spreadsheet. =====

/** Is `Cell(c)(r)` empty? */
def isEmptyCell(c: Column)(r: Row): Boolean = Cell(c,r) match{
  case Empty => true; case _ => false
}

/** Find the first empty cell in column `c` from row `r` onwards. */
def firstEmptyInColumn(c: Column, r: Row): Row = 
  if(isEmptyCell c r) r else firstEmptyInColumn(c, r+1)

/** Find the first empty cell in column `c`. */
def firstEmptyInColumn(c: Column): Row = firstEmptyInColumn(c, #0)

/** The cells in columns `cols` in row `row`.  Each cell should have type `A`. */
def cells[A <: CellType](cols: List[Column])(row: Row): List[A] =
  [Cell(col,row): A | col <- cols]

/** The cells in rows `rows` in column `col`.  Each cell should have type `A`. */
def cells[A <: CellType](col: Column)(rows: List[Row]): List[A] =
  [Cell(col,row): A | row <- rows]

// ========= Sorting functions

/** Sort the block defined by columns `cols` and rows `row` according to
  * column `c`.  That column should contain values of type `A`. */
def sortBlockByColumn[A <: CellType](
    cols: List[Column], rows: List[Row], c: Column) = {
  def before(r1: Row, r2: Row) = Cell(c,r1): A <= Cell(c,r2): A
  sortBlockBy(cols, rows, before)
}
